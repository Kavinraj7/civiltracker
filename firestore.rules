rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Returns the user profile data from app_users
    function getUserData() {
      return get(/databases/$(database)/documents/app_users/$(request.auth.uid)).data;
    }

    // Verifies if the authenticated user has Owner role
    function isOwner() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/app_users/$(request.auth.uid)) &&
         getUserData().role == 'Owner')
      );
    }

    // 1. Team & Incharges: Only Owners can create, modify, or delete user accounts.
    match /app_users/{userId} {
      allow read: if isAuthenticated();
      // Allow user creation if the user is an Owner, or during first-time database initialization
      allow create: if isAuthenticated() && (isOwner() || !exists(/databases/$(database)/documents/app_users/{userId}));
      allow update, delete: if isOwner();
    }

    // 2. Projects: Only Owners can create or delete projects. All authenticated staff can read & update.
    match /projects/{projectId} {
      allow read: if isAuthenticated();
      allow create, delete: if isOwner();
      allow update: if isAuthenticated();
    }

    // 3. Billing Packages: Only Owners can delete packages.
    match /packages/{packageId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isOwner();
    }

    // 4. Vendors: Only Owners can delete vendors.
    match /vendors/{vendorId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isOwner();
    }

    // 5. Operations Ledger: Material transactions, wages, expenses, client receipts, internal transfers
    match /vendor_transactions/{id} {
      allow read, write: if isAuthenticated();
    }

    match /client_payments/{id} {
      allow read, write: if isAuthenticated();
    }

    match /daily_wages/{id} {
      allow read, write: if isAuthenticated();
    }

    match /project_expenses/{id} {
      allow read, write: if isAuthenticated();
    }

    match /internal_transactions/{id} {
      allow read, write: if isAuthenticated();
    }

    // Default deny for unmatched document paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

